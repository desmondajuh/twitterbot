{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "dist-electron",
    "rootDir": ".",
    "strict": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [
    "electron/**/*",
    "src/automation/**/*",
    "src/db/**/*",
    "src/queue/**/*",
    "src/types/**/*",
    "src/utils/**/*",
    "src/validation/**/*"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "dist",
    "dist-electron",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
